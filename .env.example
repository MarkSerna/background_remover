# ==========================================
# BACKGROUND REMOVER - CONFIGURACIÓN GENERAL
# ==========================================

# Directorios de entrada y salida predeterminados
INPUT_DIR=input
OUTPUT_DIR=output
PROCESSED_DIR=input/processed
ERROR_DIR=input/error
LOGS_DIR=logs

# Configuración de Fondo
# Opciones: white, transparent, #FFFFFF, o RGB "255,255,255"
BG_COLOR=255,255,255

# Formato y Calidad de Salida
# Formatos soportados: JPEG, PNG, WEBP
OUTPUT_FORMAT=JPEG
OUTPUT_QUALITY=95

# Configuración del Motor de IA Rembg
# Modelos disponibles: u2net, u2netp, isnet-general-use, birefnet-general
DEFAULT_MODEL=u2net
ALPHA_MATTING=false
ALPHA_MATTING_FOREGROUND_THRESHOLD=240
ALPHA_MATTING_BACKGROUND_THRESHOLD=10
ALPHA_MATTING_ERODE_SIZE=10

# Ajustes de Imagen
AUTO_CROP=false
PADDING_PERCENT=5

# Procesamiento por Lotes y Rendimiento
# ADVERTENCIA: Límite máximo de 20 imágenes por lote. Entre más imágenes se procesen simultáneamente, mayor es el consumo de memoria y la probabilidad de errores.
MAX_BATCH_LIMIT=20
BATCH_LIMIT=20
MAX_WORKERS=4
TIMEOUT_SECONDS=60
MAX_FILE_SIZE_MB=50

# Modo Vigilante (Watcher)
WATCHER_DEBOUNCE_SECONDS=2
ARCHIVE_ORIGINAL=true

# Mantenimiento y Limpieza
CLEANUP_DAYS=30
